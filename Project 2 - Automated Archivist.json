    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const rawText = item.json?.content?.parts?.[0]?.text ?? '';\n\n  // Strip markdown code fences (```json and ```) and whitespace\n  const cleanJsonString = rawText\n    .replace(/^```(?:json)?\\s*/i, '')\n    .replace(/\\s*```$/, '')\n    .trim();\n\n  let parsedData = {};\n  try {\n    parsedData = JSON.parse(cleanJsonString);\n\n    // If invoice_description is returned as an array/list, convert it to plain text\n    if (Array.isArray(parsedData.invoice_description)) {\n      parsedData.invoice_description = parsedData.invoice_description\n        .map(entry => (typeof entry === 'object' ? JSON.stringify(entry) : String(entry)))\n        .join(', ');\n    } else if (typeof parsedData.invoice_description !== 'string') {\n      parsedData.invoice_description = String(parsedData.invoice_description ?? '');\n    }\n  } catch (error) {\n    parsedData = { error: 'Failed to parse JSON', raw: rawText };\n  }\n\n  return {\n    json: parsedData\n  };\n});"
      },
